<% layout("./layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-3">
        <h3 class="mb-6 mt-6"><%= listing.title %></h3>
    </div>
</div>

<div class="row">
    <div class="col-6 offset-3">
        <div class="listing-card">
            <img src="<%= listing.image %>" class="card-img-top show-img mb-5" alt="listing_image" />
            <div class="card-body">
              <p class="card-text">
                <%= listing.description %> <br />
                &#8377; <%= String(listing.price).replace(/\B(?=(\d{3})+(?!\d))/g, ",") %> / night<br />
                <%= listing.location %>, &nbsp;<%= listing.country %> <br />
              </p>
            </div>
          </div>
    </div>
</div>

<div class="btns mb-6">
    <div class="btn show-edit-btn offset-3">
        <a href="http://localhost:8080/listings/<%= listing._id %>/edit">Edit</a>
      </div>
      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn delete-btn offset-5">Delete</button>
      </form>
</div>

<div class="class=col-8 offset-3">
  <hr>
  <h4>Leave a Review</h4>
  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
    <div class="mb-6">
      <label for="rating" class="mb-2">Rating </label>
      <input type="range" min="1" max="5" id="rating" name="rating" class="form-range">
    </div>
    <div class="mb-6">
      <label for="comment" class="form-label">Comment</label>
      <textarea name="comment" id="comment" cols="30" rows="5" class="form-control" required></textarea>
      <div class="invalid-feedback">
        Please add some comments review.
      </div>
    </div>
    <button class="btn mb-3 btn-outline theme-secondary" type="submit">Submit</button>
  </form>
</div>

<div class="class=col-8 offset-3 mb-6">
  <hr>
  <h4 >All Reviews</h4>
  <div class="row mt-6">
    <% for(let review of listing.reviews) {%>
      <div class="card col-5 ms-6 mb-6">
        <div class="card-body">
          <h5 class="card-title">Kalash Shah</h5>
          <p class="card-text"><%= review.comment %></p>
          <p class="card-text"> <%= review.rating %> stars</p>
        </div>

        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3 mt-3" method="post">
          <button type="submit" class="btn btn-secondary">Delete</button>
        </form>
      </div>
    <% } %>
  </div>
</div>