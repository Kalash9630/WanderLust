<% layout("./layouts/boilerplate") %>

<div class="row mt-5 mb-5">
    <div class="col-10 offset-1">

        <!-- Listing Title -->
        <div class="listing-heading mb-4">
            <h2 class="fw-bold mb-2"><%= listing.title %></h2>
            <p class="text-muted mb-0">
                <i class="fa-solid fa-location-dot me-2"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <!-- Listing Card -->
        <div class="listing-details-card">

            <div class="listing-image-container">
                <img
                    src="<%= listing.image %>"
                    class="listing-details-img"
                    alt="listing_image"
                />
            </div>

            <div class="listing-details-body">

                <!-- Owner -->
                <div class="listing-owner d-flex align-items-center mb-4">
                    <div class="listing-owner-avatar">
                        <%= listing.owner.username.charAt(0).toUpperCase() %>
                    </div>

                    <div class="ms-3">
                        <p class="text-muted mb-1 small">Posted by</p>
                        <h6 class="fw-bold mb-0">
                            <%= listing.owner.username
                                .toLowerCase()
                                .split(" ")
                                .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                                .join(" ") %>
                        </h6>
                    </div>
                </div>

                <hr>

                <!-- Description -->
                <div class="mb-4 mt-4">
                    <h5 class="fw-bold mb-5">About this place</h5>
                    <p class="listing-description mb-0">
                        <%= listing.description %>
                    </p>
                </div>

                <hr>

                <!-- Price -->
                <div class="listing-price-section mt-4 mb-4">
                    <h4 class="fw-bold mb-1">
                        &#8377; <%= String(listing.price).replace(/\B(?=(\d{3})+(?!\d))/g, ",") %>
                        <span class="price-night">/ night</span>
                    </h4>
                    <small class="text-muted">Price per night</small>
                </div>

                <!-- BOOK NOW BUTTON -->
                <div class="show-booking-section mb-4">
                    <a href="/listings/<%= listing._id %>/book/guest-details"
                    class="show-book-btn">
                        <i class="fa-regular fa-calendar-check"></i>
                        Book Now
                        <i class="fa-solid fa-arrow-right booking-arrow"></i>
                    </a>

                    <small class="booking-note">
                        <i class="fa-solid fa-shield-halved"></i>
                        Continue to complete your reservation
                    </small>
                </div>

                <!-- Location -->
                <div class="listing-location-section">
                    <h6 class="fw-bold mb-2">
                        <i class="fa-solid fa-map-location-dot me-2"></i>
                        Location
                    </h6>
                    <p class="text-muted mb-0">
                        <%= listing.location %>, <%= listing.country %>
                    </p>
                </div>

            </div>
        </div>

        <!-- Edit and Delete Buttons -->
        <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
            <div class="listing-action-buttons mt-4">
                <a href="http://localhost:8080/listings/<%= listing._id %>/edit"
                   class="listing-edit-btn">
                    <i class="fa-solid fa-pen me-2"></i>
                    Edit Listing
                </a>

                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                    <button type="submit" class="listing-delete-btn">
                        <i class="fa-solid fa-trash me-2"></i>
                        Delete Listing
                    </button>
                </form>
            </div>
        <% } %>

    </div>
</div>



<!-- review form -->
<% if (currUser) { %>
  <div class="col-10 offset-1 mt-5 mb-5">
      <hr>

      <div class="review-form-card">
          <div class="d-flex align-items-center mb-4">
              <div class="review-avatar">
                  <%= currUser.username.charAt(0).toUpperCase() %>
              </div>

              <div class="ms-3">
                  <h4 class="fw-bold mb-1">Write a Review</h4>
                  <p class="text-muted mb-0">
                      Share your experience with other travellers
                  </p>
              </div>
          </div>

          <form action="/listings/<%= listing._id %>/reviews"
                method="POST"
                class="needs-validation"
                novalidate>

              <div class="mb-4">
                  <label for="rating" class="form-label fw-semibold">
                      How would you rate this place?
                  </label>

                  <select name="rating" id="rating" class="form-select review-input" required>
                      <option value="" selected disabled>Select your rating</option>
                      <option value="5">★★★★★ — Excellent</option>
                      <option value="4">★★★★ — Very Good</option>
                      <option value="3">★★★ — Good</option>
                      <option value="2">★★ — Fair</option>
                      <option value="1">★ — Poor</option>
                  </select>

                  <div class="invalid-feedback">
                      Please select a rating.
                  </div>
              </div>

              <div class="mb-4">
                  <label for="comment" class="form-label fw-semibold">
                      Your Experience
                  </label>

                  <textarea
                      name="comment"
                      id="comment"
                      rows="5"
                      class="form-control review-input"
                      placeholder="What did you like about this place? Share your experience..."
                      required
                  ></textarea>

                  <div class="invalid-feedback">
                      Please write a review before submitting.
                  </div>
              </div>

              <div class="d-flex justify-content-end">
                  <button type="submit" class="review-submit-btn">
                      <i class="fa-solid fa-paper-plane me-2"></i>
                      Post Review
                  </button>
              </div>
          </form>
      </div>
  </div>
<% } %>

<!-- all review section  -->
<% if (listing.reviews.length > 0) { %>
  <div class="col-10 offset-1 mt-5 mb-5">
      <hr>

      <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
              <h3 class="fw-bold mb-1">Guest Reviews</h3>
              <p class="text-muted mb-0">
                  <%= listing.reviews.length %> reviews from our guests
              </p>
          </div>
      </div>

      <div class="row g-4">
          <% for (let review of listing.reviews) { %>
              <div class="col-md-6">
                  <div class="review-card h-100">

                      <div class="d-flex align-items-center mb-3">
                          <div class="review-avatar">
                              <%= review.author.username.charAt(0).toUpperCase() %>
                          </div>

                          <div class="ms-3">
                            <h6 class="fw-bold mb-0">
                                <%= review.author.username
                                    .toLowerCase()
                                    .split(" ")
                                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                                    .join(" ") %>
                            </h6>
                              <small class="text-muted">Verified reviewer</small>
                          </div>
                      </div>

                      <div class="review-stars mb-3">
                          <% for (let i = 1; i <= 5; i++) { %>
                              <% if (i <= review.rating) { %>
                                  <i class="fa-solid fa-star"></i>
                              <% } else { %>
                                  <i class="fa-regular fa-star"></i>
                              <% } %>
                          <% } %>
                          <span class="rating-number"><%= review.rating %>/5</span>
                      </div>

                      <p class="review-comment mb-3">
                          <%= review.comment %>
                      </p>

                      <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                          <div class="text-end mt-auto">
                              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST">

                                  <button type="submit" class="review-delete-btn">
                                      <i class="fa-regular fa-trash-can"></i>
                                      Delete review
                                  </button>
                              </form>
                          </div>
                      <% } %>

                  </div>
              </div>
          <% } %>
      </div>
  </div>
<% } %>

<!-- Map Section -->
<div class="row mt-5 mb-5">
    <div class="col-10 offset-1">
        <hr>
        <h3 class="fw-bold mb-3">Where you'll be</h3>
        <p class="text-muted">
            <%= listing.location %>, <%= listing.country %>
        </p>
        <div
            id="map"
            data-map-token="<%= mapToken %>"
            data-location="<%= listing.location %>, <%= listing.country %>"
        ></div>
    </div>
</div>

<script>
    mapboxgl.accessToken = <%- JSON.stringify(mapToken) %>;

    const locationName = <%- JSON.stringify(listing.location + ', ' + listing.country) %>;

</script>