<% layout("./layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-3">
        <h3 class="mb-6 mt-6"><%= listing.title %></h3>
    </div>
</div>

<div class="row">
    <div class="col-6 offset-3">
        <div class="card">
            <img src="<%= listing.image %>" class="card-img-top show-img mb-5" alt="listing_image" />
            <div class="card-body">
              <p class="card-text">
                <%= listing.description %> <br />
                &#8377; <%= String(listing.price).replace(/\B(?=(\d{3})+(?!\d))/g, ",") %> / night<br />
                <%= listing.location %>, &nbsp;<%= listing.country %> <br />
              </p>
            </div>
          </div>
    </div>
</div>


<div class="btns mb-6">
    <div class="btn show-edit-btn offset-3">
        <a href="http://localhost:8080/listings/<%= listing._id %>/edit">Edit</a>
      </div>
      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn delete-btn offset-5">Delete</button>
      </form>
</div>
