<% layout("./layouts/boilerplate") %>
<h3 class="mb-6 mt-6">All Listings</h3>
<!-- <a href="http://localhost:8080/listings/new">
    <button>Create New</button>
</a> -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-6">
    <% for(listing of allListings) {%>
        <div class="listing-card" style="width: 18rem;">
            <a href="http://localhost:8080/listings/<%= listing._id %>">

                <div class="card-image-overlay">
                    <img src="<%= listing.image %>" class="card-img-top" alt="listing_image" style="height: 17rem;">
                </div>
                <div class="card-body">
                    <p class="card-text">
                        <b>
                            <%= listing.title %>
                        </b><br>
                        &#8377; <%= String(listing.price).replace(/\B(?=(\d{3})+(?!\d))/g, ",") %> / night
                    </p>
                </div>
            </a>
        </div>

    <% } %>
</div>