<% layout("/layouts/boilerplate") %>

<div class="contact-page">
  <!-- Hero Section -->
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <div class="contact-hero-content">
        <span class="contact-eyebrow">
          <span class="eyebrow-dot"></span>
          WE'RE HERE FOR YOU
        </span>

        <h1>
          Every great journey
          <span>starts with a conversation.</span>
        </h1>

        <p>
          Whether you need help with a booking, have a question about a
          property, or simply want to say hello, we're always happy to hear from
          you.
        </p>

        <div class="contact-hero-actions">
          <a href="#contact-form" class="contact-primary-btn">
            Get in touch
            <i class="fa-solid fa-arrow-right"></i>
          </a>

          <a href="#contact-faq" class="contact-text-link">
            Explore FAQs
            <i class="fa-solid fa-chevron-down"></i>
          </a>
        </div>

        <div class="contact-hero-note">
          <i class="fa-regular fa-clock"></i>
          We're always happy to hear from you.
        </div>
      </div>

      <!-- Decorative Travel Visual -->
      <div class="contact-hero-visual">
        <div class="travel-visual-circle circle-one"></div>
        <div class="travel-visual-circle circle-two"></div>

        <div class="travel-visual-card">
          <div class="visual-card-top">
            <span>YOUR NEXT CHAPTER</span>
            <i class="fa-solid fa-location-dot"></i>
          </div>

          <div class="visual-globe">
            <i class="fa-solid fa-earth-americas"></i>
          </div>

          <div class="visual-card-bottom">
            <div>
              <span>THE WORLD IS WAITING</span>
              <h3>Let's make it happen.</h3>
            </div>

            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </div>
        </div>

        <div class="visual-floating-card">
          <div class="floating-card-icon">
            <i class="fa-solid fa-heart"></i>
          </div>
          <div>
            <strong>We're listening.</strong>
            <span>Your journey matters to us.</span>
          </div>
        </div>

        <div class="visual-decoration decoration-one"></div>
        <div class="visual-decoration decoration-two"></div>
      </div>
    </div>
  </section>

  <div class="contact-container">
    <!-- Contact Information -->
    <section class="contact-info-section">
      <div class="contact-section-heading">
        <span class="contact-section-label">HOW CAN WE HELP?</span>
        <h2>We're just a message away.</h2>
        <p>
          Choose what you need help with, and we'll point you in the right
          direction.
        </p>
      </div>

      <div class="contact-info-grid">
        <!-- Booking Support -->
        <div class="contact-info-card">
          <div class="contact-info-top">
            <div class="contact-info-icon">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
          </div>

          <h3>Booking Support</h3>

          <p>
            Questions about reservations, booking details, or your upcoming
            stay?
          </p>

          <a href="#contact-form" class="contact-card-link">
            Get booking help
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <!-- Listing Support -->
        <div class="contact-info-card">
          <div class="contact-info-top">
            <div class="contact-info-icon">
              <i class="fa-solid fa-house"></i>
            </div>
          </div>

          <h3>Listing Support</h3>

          <p>
            Need assistance creating, updating, or managing your property
            listings?
          </p>

          <a href="#contact-form" class="contact-card-link">
            Get listing help
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <!-- Account Support -->
        <div class="contact-info-card">
          <div class="contact-info-top">
            <div class="contact-info-icon">
              <i class="fa-solid fa-user-shield"></i>
            </div>
          </div>

          <h3>Account Support</h3>

          <p>
            Having trouble with your profile, wishlist, or account settings?
          </p>

          <a href="#contact-form" class="contact-card-link">
            Get account help
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <section class="contact-form-section" id="contact-form">
      <div class="contact-form-layout">
        <!-- Left Information Panel -->
        <div class="contact-form-sidebar">
          <span class="contact-section-label"> LET'S CONNECT </span>

          <h2>
            We'd love to
            <span>hear from you.</span>
          </h2>

          <p>
            Have something on your mind? Send us a message and share the
            details. We're here to make your WanderLust experience better.
          </p>

          <div class="contact-email-box">
            <div class="contact-email-icon">
              <i class="fa-regular fa-envelope"></i>
            </div>

            <div>
              <span>EMAIL OUR SUPPORT TEAM</span>

              <a href="">
                support@wanderlust.com
              </a>
            </div>

            <i class="fa-solid fa-arrow-up-right-from-square email-arrow"></i>
          </div>

          <div class="contact-sidebar-divider"></div>

          <div class="contact-promise">
            <i class="fa-solid fa-shield-heart"></i>

            <div>
              <strong>Your message matters.</strong>
              <span> Your inquiry will be handled with care. </span>
            </div>
          </div>

          <div class="contact-sidebar-decoration">
            <i class="fa-solid fa-compass"></i>
          </div>
        </div>

        <!-- Right Form -->
        <div class="contact-form-wrapper">
          <div class="contact-form-heading">
            <span>DROP US A LINE</span>
            <h3>Send us a message</h3>
            <p>All fields are required.</p>
          </div>

          <form action="/contact" method="POST" class="contact-form needs-validation" novalidate>
            <div class="row">
              <!-- Name -->
              <div class="col-md-6 mb-4">
                <label for="contactName" class="form-label"> Full Name </label>

                <input
                  type="text"
                  class="form-control"
                  id="contactName"
                  name="name"
                  placeholder="Your full name"
                  required
                />
                <div class="invalid-feedback">
                    Please enter your valid full name.
                </div>
              </div>

              <!-- Email -->
              <div class="col-md-6 mb-4">
                <label for="contactEmail" class="form-label">
                  Email Address
                </label>

                <input
                  type="email"
                  class="form-control"
                  id="contactEmail"
                  name="email"
                  placeholder="you@example.com"
                  required
                />
                <div class="invalid-feedback">
                    Please enter a valid email address.
                </div>
              </div>

              <!-- Subject -->
              <div class="col-12 mb-4">
                <label for="contactSubject" class="form-label"> Subject </label>

                <input
                  type="text"
                  class="form-control"
                  id="contactSubject"
                  name="subject"
                  placeholder="What would you like to discuss?"
                  required
                />
                <div class="invalid-feedback">
                    Please enter a valid subject.
                </div>
              </div>

              <!-- Message -->
              <div class="col-12 mb-4">
                <label for="contactMessage" class="form-label">
                  Your Message
                </label>

                <textarea
                  class="form-control"
                  id="contactMessage"
                  name="message"
                  rows="6"
                  placeholder="Tell us a little more about how we can help..."
                  required
                ></textarea>
                <div class="invalid-feedback">
                    Please enter a valid message.
                </div>
              </div>
            </div>

            <div class="contact-form-footer">
              <span>
                <i class="fa-solid fa-lock"></i>
                Your information stays private.
              </span>

              <button type="submit" class="contact-submit-btn">
                Send Message
                <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="contact-faq-section" id="contact-faq">
      <div class="faq-layout">
        <!-- Left Side: FAQ Introduction -->
        <div class="faq-intro">
          <div class="faq-eyebrow">
            <span></span>
            GOT QUESTIONS?
          </div>

          <h2>Everything you need to know.</h2>

          <p class="faq-description">
            Find quick answers to the most common questions about booking stays,
            managing your account, and using WanderLust.
          </p>

          <div class="faq-support-card">
            <div class="faq-support-icon">
              <i class="fa-regular fa-comments"></i>
            </div>

            <div class="faq-support-content">
              <h3>Still need a hand?</h3>
              <p>
                Our support team is always happy to help you with anything you
                need.
              </p>
              <a href="#contactName">
                Talk to our team
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="faq-bottom-note">
            <i class="fa-solid fa-circle-check"></i>
            We're here to make every stay simpler.
          </div>
        </div>

        <!-- Right Side: FAQ Accordion -->
        <div class="faq-right">
          <div class="faq-right-header">
            <div>
              <span class="faq-list-label">HELP CENTER</span>
              <h3>Frequently asked questions</h3>
            </div>
          </div>

          <div class="faq-list" id="contactFAQ">
            <!-- FAQ 01 -->
            <div class="faq-item">
              <button
                class="faq-question"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faqAnswer1"
                aria-expanded="true"
                aria-controls="faqAnswer1"
              >
                <span class="faq-number">01</span>
                <span class="faq-question-text"
                  >How can I book a property on WanderLust?</span
                >
                <span class="faq-toggle"><i class="fa-solid fa-plus"></i></span>
              </button>
              <div
                id="faqAnswer1"
                class="collapse show"
                data-bs-parent="#contactFAQ"
              >
                <div class="faq-answer">
                  Browse the available properties, select the stay that suits
                  you, and choose your check-in and check-out dates. Enter your
                  guest details, review the pricing, and confirm your booking.
                  Your booking confirmation will be sent to your registered
                  email address.
                </div>
              </div>
            </div>

            <!-- FAQ 02 -->
            <div class="faq-item">
              <button
                class="faq-question collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faqAnswer2"
                aria-expanded="false"
                aria-controls="faqAnswer2"
              >
                <span class="faq-number">02</span>
                <span class="faq-question-text"
                  >Where can I view my bookings?</span
                >
                <span class="faq-toggle"><i class="fa-solid fa-plus"></i></span>
              </button>
              <div
                id="faqAnswer2"
                class="collapse"
                data-bs-parent="#contactFAQ"
              >
                <div class="faq-answer">
                  Log in to your WanderLust account and navigate to My Account.
                  Select My Bookings to view your upcoming and completed
                  reservations along with their booking details.
                </div>
              </div>
            </div>

            <!-- FAQ 03 -->
            <div class="faq-item">
              <button
                class="faq-question collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faqAnswer3"
                aria-expanded="false"
                aria-controls="faqAnswer3"
              >
                <span class="faq-number">03</span>
                <span class="faq-question-text">Can I cancel my booking?</span>
                <span class="faq-toggle"><i class="fa-solid fa-plus"></i></span>
              </button>
              <div
                id="faqAnswer3"
                class="collapse"
                data-bs-parent="#contactFAQ"
              >
                <div class="faq-answer">
                  Yes. Visit My Bookings in your account, find the reservation
                  you want to cancel, and use the cancellation option available
                  for that booking.
                </div>
              </div>
            </div>

            <!-- FAQ 04 -->
            <div class="faq-item">
              <button
                class="faq-question collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faqAnswer4"
                aria-expanded="false"
                aria-controls="faqAnswer4"
              >
                <span class="faq-number">04</span>
                <span class="faq-question-text"
                  >How can I save properties for later?</span
                >
                <span class="faq-toggle"><i class="fa-solid fa-plus"></i></span>
              </button>
              <div
                id="faqAnswer4"
                class="collapse"
                data-bs-parent="#contactFAQ"
              >
                <div class="faq-answer">
                  Use the heart icon on a property to add it to your Wishlist.
                  You can access your saved properties anytime from the My
                  Wishlist section of your account.
                </div>
              </div>
            </div>

            <!-- FAQ 05 -->
            <div class="faq-item">
              <button
                class="faq-question collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faqAnswer5"
                aria-expanded="false"
                aria-controls="faqAnswer5"
              >
                <span class="faq-number">05</span>
                <span class="faq-question-text"
                  >How can I list my property on WanderLust?</span
                >
                <span class="faq-toggle"><i class="fa-solid fa-plus"></i></span>
              </button>
              <div
                id="faqAnswer5"
                class="collapse"
                data-bs-parent="#contactFAQ"
              >
                <div class="faq-answer">
                  Log in to your account and navigate to the listing creation
                  option. Add your property's details, images, pricing, and
                  location to publish your listing on WanderLust.
                </div>
              </div>
            </div>

            <!-- FAQ 06 -->
            <div class="faq-item">
              <button
                class="faq-question collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faqAnswer6"
                aria-expanded="false"
                aria-controls="faqAnswer6"
              >
                <span class="faq-number">06</span>
                <span class="faq-question-text"
                  >How can I update my account information?</span
                >
                <span class="faq-toggle"><i class="fa-solid fa-plus"></i></span>
              </button>
              <div
                id="faqAnswer6"
                class="collapse"
                data-bs-parent="#contactFAQ"
              >
                <div class="faq-answer">
                  Open My Account and navigate to Account Settings. From there,
                  you can manage your account information and update your
                  password.
                </div>
              </div>
            </div>
          </div>

          <div class="faq-list-footer">
            <span>Didn't find what you were looking for?</span>
            <a href="#contactName">
              Contact support
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
