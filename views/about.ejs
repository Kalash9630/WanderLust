<% layout("/layouts/boilerplate") %>
<main class="about-page">
  <!-- 1. Hero Section -->
  <section class="about-hero">
    <div class="about-hero-overlay">
      <div class="about-container about-hero-content">
        <span class="about-eyebrow">WELCOME TO WANDERLUST</span>

        <h1>Every journey deserves<br />a place to call home.</h1>

        <p>
          Discover places, create memories, and find stays that make every
          journey a little more special.
        </p>

        <a href="/listings" class="about-btn about-btn-primary">
          Explore Stays
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Who We Are -->
  <section class="about-section about-story-section">
    <div class="about-container about-story-grid">
      <div class="about-story-image">
        <img
          src="/images/about-story.jpg"
          alt="A beautiful and welcoming holiday accommodation"
        />
        <div class="about-image-label">
          <i class="fa-solid fa-house"></i>
          <span>Find a place that feels like home</span>
        </div>
      </div>

      <div class="about-story-content">
        <span class="about-eyebrow about-eyebrow-dark"> OUR STORY </span>

        <h2>More than just a place to stay.</h2>

        <p>
          At WanderLust, we believe that every great journey deserves a great
          place to stay. Whether you are exploring somewhere new or taking a
          break from everyday life, finding the right accommodation can make all
          the difference.
        </p>

        <p>
          WanderLust brings property discovery and booking together in one
          convenient platform. We aim to make it easier for travelers to explore
          properties, compare their options, and find a stay that suits their
          needs.
        </p>

        <p>
          Because a memorable journey is not only about where you go, but also
          about where you stay.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Mission and Vision -->
  <section class="about-section about-mission-section">
    <div class="about-container">
      <div class="about-section-heading about-centered-heading">
        <span class="about-eyebrow about-eyebrow-dark"> WHAT DRIVES US </span>

        <h2>Our Mission & Vision</h2>

        <p>
          Creating a simpler and more enjoyable way to discover places to stay.
        </p>
      </div>

      <div class="about-mission-grid">
        <div class="about-mission-card">
          <div class="about-icon-box">
            <i class="fa-solid fa-bullseye"></i>
          </div>

          <h3>Our Mission</h3>

          <p>
            To make discovering and booking accommodation easier by bringing
            property information, useful features, and a straightforward booking
            experience together in one place.
          </p>
        </div>

        <div class="about-mission-card">
          <div class="about-icon-box">
            <i class="fa-solid fa-eye"></i>
          </div>

          <h3>Our Vision</h3>

          <p>
            To build a welcoming platform where travelers can discover
            meaningful stays and property owners can showcase their spaces to
            people looking for their next destination.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How WanderLust Works -->
  <section class="about-section about-how-section">
    <div class="about-container">
      <div class="about-section-heading about-centered-heading">
        <span class="about-eyebrow about-eyebrow-dark">
          SIMPLE & CONVENIENT
        </span>

        <h2>How WanderLust Works</h2>

        <p>Finding your next stay is just a few steps away.</p>
      </div>

      <div class="about-steps-grid">
        <div class="about-step-card">
          <!-- <span class="about-step-number">01</span> -->

          <div class="about-step-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>

          <h3>Discover Properties</h3>

          <p>
            Explore available properties and discover places that match your
            travel plans.
          </p>
        </div>

        <div class="about-step-card">
          <!-- <span class="about-step-number">02</span> -->

          <div class="about-step-icon">
            <i class="fa-solid fa-house-chimney"></i>
          </div>

          <h3>Find Your Stay</h3>

          <p>
            Explore property details, check locations, and save your favourite
            places.
          </p>
        </div>

        <div class="about-step-card">
          <!-- <span class="about-step-number">03</span> -->

          <div class="about-step-icon">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>

          <h3>Review Your Booking</h3>

          <p>
            Enter your details and review your stay information and pricing
            breakdown.
          </p>
        </div>

        <div class="about-step-card">
          <!-- <span class="about-step-number">04</span> -->

          <div class="about-step-icon">
            <i class="fa-solid fa-circle-check"></i>
          </div>

          <h3>Confirm Your Stay</h3>

          <p>
            Confirm your booking and keep track of your reservation through your
            account.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Why Choose WanderLust -->
  <section class="about-section about-why-section">
    <div class="about-container">
      <div class="about-section-heading about-centered-heading">
        <span class="about-eyebrow about-eyebrow-dark">
          THE WANDERLUST EXPERIENCE
        </span>

        <h2>Why Choose WanderLust?</h2>

        <p>
          Thoughtful features designed to make discovering and managing your
          stay more convenient.
        </p>
      </div>

      <div class="about-features-grid">
        <div class="about-feature-card">
          <div class="about-feature-icon">
            <i class="fa-solid fa-compass"></i>
          </div>

          <h3>Easy Property Discovery</h3>

          <p>
            Explore different properties and find stays that match your
            preferences.
          </p>
        </div>

        <div class="about-feature-card">
          <div class="about-feature-icon">
            <i class="fa-solid fa-sliders"></i>
          </div>

          <h3>Useful Filters</h3>

          <p>Narrow down your options using price and location filters.</p>
        </div>

        <div class="about-feature-card">
          <div class="about-feature-icon">
            <i class="fa-solid fa-map-location-dot"></i>
          </div>

          <h3>Explore Locations</h3>

          <p>
            View property locations on a map and get a better idea of where you
            will be staying.
          </p>
        </div>

        <div class="about-feature-card">
          <div class="about-feature-icon">
            <i class="fa-solid fa-heart"></i>
          </div>

          <h3>Your Wishlist</h3>

          <p>
            Save properties you love and revisit them whenever you are ready.
          </p>
        </div>

        <div class="about-feature-card">
          <div class="about-feature-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>

          <h3>Simple Booking</h3>

          <p>
            Follow a straightforward booking process and keep your reservations
            organized.
          </p>
        </div>

        <div class="about-feature-card">
          <div class="about-feature-icon">
            <i class="fa-solid fa-star"></i>
          </div>

          <h3>Guest Reviews</h3>

          <p>
            Read property reviews and share your own experiences with other
            travelers.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. For Guests and Property Owners -->
  <section class="about-section about-audience-section">
    <div class="about-container">
      <div class="about-section-heading about-centered-heading">
        <span class="about-eyebrow about-eyebrow-dark">
          ONE PLATFORM, TWO EXPERIENCES
        </span>

        <h2>Made for Travelers & Property Owners</h2>

        <p>
          Whether you are looking for a stay or sharing a space, WanderLust
          brings both experiences together.
        </p>
      </div>

      <div class="about-audience-grid">
        <div class="about-audience-card about-guest-card">
          <div class="about-audience-icon">
            <i class="fa-solid fa-suitcase-rolling"></i>
          </div>

          <span class="about-audience-label">FOR TRAVELERS</span>

          <h3>Discover your next favourite stay.</h3>

          <p>
            Explore properties, compare options, save favourites, and manage
            your bookings from one place.
          </p>

          <a href="/listings" class="about-text-link">
            Explore Properties
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="about-audience-card about-host-card">
          <div class="about-audience-icon">
            <i class="fa-solid fa-house-chimney-user"></i>
          </div>

          <span class="about-audience-label">FOR PROPERTY OWNERS</span>

          <h3>Share your space with the world.</h3>

          <p>
            Showcase your property, share its details, and make it discoverable
            to travelers searching for their next stay.
          </p>

          <a href="/listings/new" class="about-text-link">
            List Your Property
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Our Values -->
  <section class="about-section about-values-section">
    <div class="about-container">
      <div class="about-section-heading about-centered-heading">
        <span class="about-eyebrow about-eyebrow-dark">
          WHAT MATTERS TO US
        </span>

        <h2>The Values Behind WanderLust</h2>

        <p>The principles that guide the experience we aim to create.</p>
      </div>

      <div class="about-values-grid">
        <div class="about-value-item">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <h3>Simplicity</h3>
          <p>Making property discovery and booking straightforward.</p>
        </div>

        <div class="about-value-item">
          <i class="fa-solid fa-handshake"></i>
          <h3>Transparency</h3>
          <p>Presenting clear property information and pricing details.</p>
        </div>

        <div class="about-value-item">
            <i class="fa-solid fa-house"></i>
          <h3>Comfort</h3>
          <p>Helping travelers find places that suit their needs.</p>
        </div>

        <div class="about-value-item">
          <i class="fa-solid fa-people-group"></i>
          <h3>Connection</h3>
          <p>
            Bringing travelers and property owners together through one
            platform.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Meet the Founder -->
  <section class="about-section about-founder-section">
    <div class="about-container about-founder-grid">
      <div class="about-founder-photo-wrapper">
        <img
          src="/images/kalash-shah.jpg"
          alt="Kalash Shah, founder and creator of WanderLust"
          class="about-founder-photo"
        />

        <div class="about-founder-photo-caption">
          <span>THE PERSON BEHIND THE PLATFORM</span>
        </div>
      </div>

      <div class="about-founder-content">
        <span class="about-eyebrow about-eyebrow-dark"> A PERSONAL NOTE </span>

        <h2>Meet the Founder</h2>

        <h3>Kalash Shah</h3>

        <span class="about-founder-role">
          Founder & Creator of WanderLust
        </span>

        <p>
            Hi, I'm Kalash! I'm passionate about technology, software development,
            and creating digital experiences that make everyday tasks easier.
        </p>
        
        <p>
            With an academic background in the computer science field and a
            strong interest in software engineering, I enjoy turning ideas into
            practical applications. As a student at the University of Waterloo,
            I continue to explore new technologies and build meaningful digital
            experiences. WanderLust is one such idea, bringing property discovery
            and booking together in a simple platform.
        </p>
        
        <p>
            This project represents my interest in building useful products,
            exploring new ideas, and continuously learning through development.
            I hope WanderLust makes discovering your next stay a little easier.
        </p>

        <!-- <div class="about-founder-signoff">
          <span>Happy exploring!</span>
          <strong>Kalash Shah</strong>
        </div> -->
      </div>
    </div>
  </section>

  <!-- 9. Final Call to Action -->
  <section class="about-cta-section">
    <div class="about-cta-overlay">
      <div class="about-container about-cta-content">
        <span class="about-eyebrow"> YOUR NEXT JOURNEY STARTS HERE </span>

        <h2>Your next favourite stay is waiting.</h2>

        <p>
          Explore new places, discover wonderful stays, and start planning your
          next journey with WanderLust.
        </p>

        <div class="about-cta-actions">
          <a href="/listings" class="about-btn about-btn-primary">
            Explore Properties
            <i class="fa-solid fa-arrow-right"></i>
          </a>

          <a href="/contact" class="about-btn about-btn-outline">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</main>
