<%
    // These flags will be supplied by the backend after password verification
    const isPasswordChangeVerified =
        typeof passwordChangeVerified !== "undefined" && passwordChangeVerified;

    const isAccountDeletionVerified =
        typeof accountDeletionVerified !== "undefined" && accountDeletionVerified;
%>
<% layout("./layouts/boilerplate") %>

<div class="account-page">
    <div class="account-container">

        <!-- Account Header -->
        <div class="account-header">
            <h2>My Account</h2>
            <p>Manage your profile and WanderLust activities.</p>
        </div>

        <!-- Account Layout -->
        <div class="account-layout">

            <!-- Sidebar -->
            <aside class="account-sidebar">
                <div class="account-sidebar-header">
                    <h5>Account Menu</h5>
                </div>

                <nav class="account-menu">
                    <a href="/account" class="account-menu-link">
                        <i class="fa-regular fa-user"></i>
                        <span>My Profile</span>
                    </a>

                    <a href="/account/bookings" class="account-menu-link">
                        <i class="fa-regular fa-calendar-check"></i>
                        <span>My Bookings</span>
                    </a>

                    <a href="/account/wishlist" class="account-menu-link">
                        <i class="fa-regular fa-heart"></i>
                        <span>My Wishlist</span>
                    </a>

                    <a href="/account/listings" class="account-menu-link">
                        <i class="fa-solid fa-house"></i>
                        <span>My Listings</span>
                    </a>

                    <a href="/account/reviews" class="account-menu-link">
                        <i class="fa-regular fa-star"></i>
                        <span>My Reviews</span>
                    </a>

                    <a href="/account/settings" class="account-menu-link active">
                        <i class="fa-solid fa-gear"></i>
                        <span>Account Settings</span>
                    </a>
                </nav>
            </aside>

            <!-- Main Content -->
            <main class="account-content">

                <div class="account-content-header">
                    <h3>Account Settings</h3>
                    <p>Manage your password and account security.</p>
                </div>

                <!-- ====================================== -->
                <!-- CHANGE PASSWORD SECTION -->
                <!-- ====================================== -->

                <section class="settings-section">

                    <div class="settings-section-heading">
                        <div class="settings-section-icon">
                            <i class="fa-solid fa-lock"></i>
                        </div>

                        <div>
                            <h4>Change Password</h4>
                            <p>Update your password to keep your account secure.</p>
                        </div>
                    </div>

                    <!-- STEP 1: Verify Current Password -->
                    <div
                        id="passwordVerificationStep"
                        <%= isPasswordChangeVerified ? "hidden" : "" %>
                    >

                        <form
                            action="/account/verify-password"
                            method="POST"
                            id="verifyPasswordForm"
                            class="needs-validation"
                            novalidate
                        >
                            <div class="settings-form-group">
                                <label for="currentPassword">Current Password</label>

                                <div class="settings-password-wrapper">
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="currentPassword"
                                        name="currentPassword"
                                        minlength="3"
                                        placeholder="Enter your current password"
                                        required
                                    />

                                    <button
                                        type="button"
                                        class="settings-password-toggle"
                                        data-target="currentPassword"
                                        aria-label="Show password"
                                    >
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <div class="invalid-feedback">
                                        Please enter your current password (minimum 3 characters).
                                    </div>
                                </div>
                            </div>

                            <div class="settings-form-actions">
                                <button type="submit" class="settings-primary-btn">
                                    Continue
                                    <i class="fa-solid fa-arrow-right"></i>
                                </button>
                            </div>

                            <div
                                id="passwordVerificationMessage"
                                class="settings-status-message"
                                role="status"
                                hidden
                            ></div>
                        </form>
                    </div>

                    <!-- STEP 2: Enter New Password -->
                    <div
                        id="passwordChangeStep"
                        <%= isPasswordChangeVerified ? "" : "hidden" %>
                    >

                        <form
                            action="/account/change-password"
                            method="POST"
                            id="changePasswordForm"
                            class="needs-validation"
                            novalidate
                        >

                            <!-- New Password -->
                            <div class="settings-form-group">
                                <label for="newPassword">New Password</label>

                                <div class="settings-password-wrapper">
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="newPassword"
                                        name="newPassword"
                                        minlength="3"
                                        placeholder="Enter your new password"
                                        required
                                    />

                                    <button
                                        type="button"
                                        class="settings-password-toggle"
                                        data-target="newPassword"
                                        aria-label="Show password"
                                    >
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <div class="invalid-feedback">
                                        Please enter your new password.
                                    </div>
                                </div>
                            </div>

                            <!-- Confirm New Password -->
                            <div class="settings-form-group">
                                <label for="confirmNewPassword">Confirm New Password</label>

                                <div class="settings-password-wrapper">
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="confirmNewPassword"
                                        name="confirmNewPassword"
                                        minlength="3"
                                        placeholder="Confirm your new password"
                                        required
                                    />

                                    <button
                                        type="button"
                                        class="settings-password-toggle"
                                        data-target="confirmNewPassword"
                                        aria-label="Show password"
                                    >
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <div class="invalid-feedback">
                                        Please make sure both passwords match.
                                    </div>
                                </div>
                            </div>

                            <div
                                id="changePasswordMessage"
                                class="settings-status-message"
                                role="status"
                                hidden
                            ></div>
                        </form>

                        <!-- Change Password Actions -->
                        <div class="settings-form-actions">

                            <!-- Separate Cancel Form -->
                            <form
                                action="/account/cancel-password-change"
                                method="POST"
                                id="cancelPasswordChangeForm"
                            >
                                <button
                                    type="submit"
                                    class="settings-cancel-btn"
                                >
                                    Cancel
                                </button>
                            </form>

                            <!-- Submit the Change Password Form -->
                            <button
                                type="submit"
                                form="changePasswordForm"
                                class="settings-primary-btn"
                            >
                                Change Password
                            </button>
                        </div>
                    </div>

                </section>

                <!-- ====================================== -->
                <!-- DELETE ACCOUNT SECTION -->
                <!-- ====================================== -->

                <section class="settings-section settings-delete-section">

                    <div class="settings-section-heading">
                        <div class="settings-section-icon settings-delete-icon">
                            <i class="fa-solid fa-user-xmark"></i>
                        </div>

                        <div>
                            <h4>Delete Account</h4>
                            <p>Permanently delete your WanderLust account.</p>
                        </div>
                    </div>

                    <div class="settings-delete-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <p>
                            Deleting your account is a permanent action. Your account
                            and associated data will be deleted and cannot be recovered.
                        </p>
                    </div>

                    <!-- STEP 1: Verify Password Before Deletion -->
                    <div
                        id="deleteVerificationStep"
                        <%= isAccountDeletionVerified ? "hidden" : "" %>
                    >

                        <form
                            action="/account/verify-delete-password"
                            method="POST"
                            id="verifyDeletePasswordForm"
                            class="needs-validation"
                            novalidate
                        >
                            <div class="settings-form-group">
                                <label for="deleteCurrentPassword">Current Password</label>

                                <div class="settings-password-wrapper">
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="deleteCurrentPassword"
                                        name="currentPassword"
                                        minlength="3"
                                        placeholder="Enter your current password"
                                        required
                                    />

                                    <button
                                        type="button"
                                        class="settings-password-toggle"
                                        data-target="deleteCurrentPassword"
                                        aria-label="Show password"
                                    >
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <div class="invalid-feedback">
                                        Please enter your current password (minimum 3 characters).
                                    </div>
                                </div>
                            </div>

                            <div class="settings-form-actions">
                                <button type="submit" class="settings-primary-btn">
                                    Continue
                                    <i class="fa-solid fa-arrow-right"></i>
                                </button>
                            </div>

                            <div
                                id="deleteVerificationMessage"
                                class="settings-status-message"
                                role="status"
                                hidden
                            ></div>
                        </form>
                    </div>

                    <!-- STEP 2: Final Account Deletion -->
                    <div
                        id="deleteConfirmationStep"
                        <%= isAccountDeletionVerified ? "" : "hidden" %>
                    >

                        <div class="settings-final-confirmation">
                            <h5>Are you sure you want to delete your account?</h5>

                            <p>
                                This action is permanent. You will lose access to your
                                WanderLust account and its associated data.
                            </p>
                        </div>

                        <div
                            class="settings-demo-message"
                            id="deleteVerifiedMessage"
                            <%= isAccountDeletionVerified ? "hidden" : "" %>
                        >
                            <i class="fa-solid fa-circle-info"></i>
                            Frontend demonstration: actual password verification will be connected to the backend.
                        </div>

                        <!-- Delete Account Actions -->
                        <div class="settings-form-actions">

                            <!-- Separate Cancel Form -->
                            <form
                                action="/account/cancel-delete"
                                method="POST"
                                id="cancelDeleteAccountForm"
                            >
                                <button type="submit" class="settings-cancel-btn">
                                    Cancel
                                </button>
                            </form>

                            <!-- Final Delete Account Form -->
                            <form
                                action="/account/delete?_method=DELETE"
                                method="POST"
                                id="deleteAccountForm"
                            >
                                <button type="submit" class="settings-delete-btn">
                                    <i class="fa-solid fa-trash-can"></i>
                                    Delete Account
                                </button>
                            </form>
                        </div>

                        <div
                            id="deleteAccountMessage"
                            class="settings-status-message"
                            role="status"
                            hidden
                        ></div>
                    </div>

                </section>

            </main>
        </div>
    </div>
</div>

<!-- Account Settings JavaScript -->
<script src="/js/settings.js"></script>