<% layout("./layouts/boilerplate") %>

    <div class="account-page">
        <div class="account-container">

            <!-- Account Header -->
            <div class="account-header">
                <h2>My Account</h2>
                <p>Manage your profile and WanderLust activities.</p>
            </div>

            <!-- Account Layout -->
            <div class="account-layout">

                <!-- Sidebar -->
                <aside class="account-sidebar">
                    <div class="account-sidebar-header">
                        <h5>Account Menu</h5>
                    </div>

                    <nav class="account-menu">
                        <a href="/account" class="account-menu-link active">
                            <i class="fa-regular fa-user"></i>
                            <span>My Profile</span>
                        </a>

                        <a href="/account/bookings" class="account-menu-link">
                            <i class="fa-regular fa-calendar-check"></i>
                            <span>My Bookings</span>
                        </a>

                        <a href="/account/wishlist" class="account-menu-link">
                            <i class="fa-regular fa-heart"></i>
                            <span>My Wishlist</span>
                        </a>

                        <a href="/account/listings" class="account-menu-link">
                            <i class="fa-solid fa-house"></i>
                            <span>My Listings</span>
                        </a>

                        <a href="/account/reviews" class="account-menu-link">
                            <i class="fa-regular fa-star"></i>
                            <span>My Reviews</span>
                        </a>

                        <a href="/account/settings" class="account-menu-link">
                            <i class="fa-solid fa-gear"></i>
                            <span>Account Settings</span>
                        </a>
                    </nav>
                </aside>

                <!-- Main Content -->
                <main class="account-content">

                    <div class="account-content-header">
                        <h3>My Profile</h3>
                        <p>View and manage your personal information.</p>
                    </div>

                    <!-- Profile Overview -->
                    <div class="profile-overview">
                        <div class="profile-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div class="profile-overview-info">
                            <h4>
                                <%= user.username ? user.username .toLowerCase() .split(" ")
                                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                                    .join(" ")
                                : " Not provided" %>
                            </h4>
                            <p>
                                <%= user.email || "Not provided" %>
                            </p>

                            <span class="profile-member-badge">
                                <i class="fa-solid fa-circle-check"></i>
                                WanderLust Member
                            </span>

                            <div class="profile-member-since">
                                <i class="fa-regular fa-calendar"></i>
                                Member since:
                                <strong>
                                    <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-GB", {
                                        day: "2-digit" , month: "long" , year: "numeric" }) : "Not available" %>
                                </strong>
                            </div>
                        </div>
                    </div>


                    <!-- Personal Information -->
                    <div class="profile-details-section" id="profileDetailsSection">

                        <div class="profile-section-heading">
                            <div>
                                <h4>Personal Information</h4>
                                <p>Your personal details and contact information.</p>
                            </div>

                            <button type="button" class="edit-profile-btn" id="editProfileBtn">
                                <i class="fa-regular fa-pen-to-square"></i>
                                Edit Profile
                            </button>
                        </div>

                        <form id="profileForm" novalidate>

                            <div class="profile-details-grid">

                                <!-- Username -->
                                <div class="profile-detail-card">
                                    <div class="profile-detail-icon">
                                        <i class="fa-regular fa-user"></i>
                                    </div>
                                    <div class="profile-detail-info">
                                        <span>Username</span>

                                        <h5 class="profile-view-value">
                                            <%= user.username || "Not provided" %>
                                        </h5>

                                        <input type="text" name="username" class="profile-edit-input"
                                            value="<%= user.username || '' %>" disabled required minlength="2">
                                        <div class="invalid-feedback">
                                            Please enter a username with at least 2 characters.
                                        </div>
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="profile-detail-card">
                                    <div class="profile-detail-icon">
                                        <i class="fa-regular fa-envelope"></i>
                                    </div>
                                    <div class="profile-detail-info">
                                        <span>Email Address</span>
                                        <h5>
                                            <%= user.email || "Not provided" %>
                                        </h5>
                                    </div>
                                </div>

                                <!-- Mobile Number -->
                                <div class="profile-detail-card">
                                    <div class="profile-detail-icon">
                                        <i class="fa-solid fa-phone"></i>
                                    </div>
                                    <div class="profile-detail-info">
                                        <span>Mobile Number</span>

                                        <h5 class="profile-view-value">
                                            <%= user.mobileNumber || "Not provided" %>
                                        </h5>

                                        <input type="tel" name="mobileNumber" id="profileMobile"
                                            class="profile-edit-input form-control"
                                            value="<%= user.mobileNumber || '' %>" pattern="[0-9]{10}" maxlength="10"
                                            inputmode="numeric" disabled>
                                        <div class="invalid-feedback">
                                            Please enter a valid 10-digit mobile number.
                                        </div>
                                    </div>
                                </div>


                                <!-- Date of Birth -->
                                <div class="profile-detail-card">
                                    <div class="profile-detail-icon">
                                        <i class="fa-regular fa-calendar"></i>
                                    </div>

                                    <div class="profile-detail-info">
                                        <span>Date of Birth</span>

                                        <h5 class="profile-view-value" id="profile-dob"
                                            data-dob="<%= user.dateOfBirth ? `${user.dateOfBirth.getUTCFullYear()}-${String(user.dateOfBirth.getUTCMonth() + 1).padStart(2, '0')}-${String(user.dateOfBirth.getUTCDate()).padStart(2, '0')}` : '' %>">
                                            <%= user.dateOfBirth ?
                                                `${String(user.dateOfBirth.getUTCDate()).padStart(2, '0' )}
                                                ${user.dateOfBirth.toLocaleString('en-GB', { month: 'long' ,
                                                timeZone: 'UTC' })} ${user.dateOfBirth.getUTCFullYear()}`
                                                : "Not provided" %>
                                        </h5>

                                        <input type="text" name="dateOfBirth" id="profileDobInput"
                                            class="profile-edit-input" placeholder="Select your DOB"
                                            value="<%= user.dateOfBirth ? `${user.dateOfBirth.getUTCFullYear()}-${String(user.dateOfBirth.getUTCMonth() + 1).padStart(2, '0')}-${String(user.dateOfBirth.getUTCDate()).padStart(2, '0')}` : '' %>"
                                            disabled readonly>
                                    </div>
                                </div>


                                <!-- Age -->
                                <div class="profile-detail-card">
                                    <div class="profile-detail-icon">
                                        <i class="fa-solid fa-cake-candles"></i>
                                    </div>
                                    <div class="profile-detail-info">
                                        <span>Age</span>
                                        <h5 id="profile-age">Not provided</h5>
                                    </div>
                                </div>

                                <!-- Gender -->
                                <div class="profile-detail-card">
                                    <div class="profile-detail-icon">
                                        <i class="fa-solid fa-venus-mars"></i>
                                    </div>
                                    <div class="profile-detail-info">
                                        <span>Gender</span>

                                        <h5 class="profile-view-value">
                                            <%= user.sex ? (user.sex==="prefer_not_to_say" ? "Prefer not to say" :
                                                user.sex.charAt(0).toUpperCase() + user.sex.slice(1)) : "Not provided"
                                                %>
                                        </h5>

                                        <select name="sex" class="profile-edit-input form-select" disabled>
                                            <option value="" <%=!user.sex ? "selected" : "" %>>
                                                Select Gender
                                            </option>
                                            <option value="male" <%=user.sex==="male" ? "selected" : "" %>>
                                                Male
                                            </option>
                                            <option value="female" <%=user.sex==="female" ? "selected" : "" %>>
                                                Female
                                            </option>
                                            <option value="other" <%=user.sex==="other" ? "selected" : "" %>>
                                                Other
                                            </option>
                                            <option value="prefer_not_to_say" <%=user.sex==="prefer_not_to_say"
                                                ? "selected" : "" %>>
                                                Prefer not to say
                                            </option>
                                        </select>
                                    </div>
                                </div>

                            </div>

                            <!-- Save and Cancel Buttons -->
                            <div class="profile-form-actions" id="profileFormActions">
                                <button type="button" class="cancel-profile-btn" id="cancelProfileBtn">
                                    Cancel
                                </button>

                                <button type="submit" class="save-profile-btn">
                                    <i class="fa-regular fa-floppy-disk"></i>
                                    Save Changes
                                </button>
                            </div>

                        </form>
                    </div>


                </main>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="/js/account.js"></script>